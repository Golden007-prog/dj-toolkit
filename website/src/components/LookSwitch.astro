---
// Booth / Daylight, the same switch as the app's sidebar. Every copy on the page stays in step.
interface Props {
  label?: string;
}
const { label = "Look" } = Astro.props;
---

<div class="switch" role="group" aria-label={label}>
  <button type="button" data-look="dark" aria-pressed="false" title="Booth: dark and calm, for clubs and late-night prep">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
    <span class="label">Booth</span>
  </button>
  <button type="button" data-look="light" aria-pressed="false" title="Daylight: bright and high-contrast, for sunny day parties">
    <svg viewBox="0 0 24 24" aria-hidden="true"
      ><circle cx="12" cy="12" r="4"></circle><path
        d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
      ></path></svg
    >
    <span class="label">Daylight</span>
  </button>
</div>

<style>
  .switch {
    display: inline-flex;
    gap: 2px;
    padding: 3px;
    border-radius: 999px;
    background: var(--ground-raised);
  }
  button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 36px;
    padding: 0 12px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: var(--size-small);
    font-weight: 550;
    cursor: pointer;
    transition:
      background-color 160ms var(--ease),
      color 160ms var(--ease);
  }
  button:hover {
    color: var(--ink);
  }
  button[aria-pressed="true"] {
    background: var(--surface);
    color: var(--ink);
    font-weight: 650;
  }
  @media (max-width: 560px) {
    /* icons only on a phone; the words stay for screen readers */
    .label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    button {
      padding: 0 11px;
    }
  }
  svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>

<script>
  const root = document.documentElement;
  const dark = matchMedia("(prefers-color-scheme: dark)");
  const current = () => root.dataset.theme || (dark.matches ? "dark" : "light");
  const sync = () =>
    document.querySelectorAll<HTMLButtonElement>("[data-look]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.look === current())));

  document.querySelectorAll<HTMLButtonElement>("[data-look]").forEach((b) =>
    b.addEventListener("click", () => {
      root.dataset.theme = b.dataset.look;
      try {
        localStorage.setItem("djtoolkit-look", b.dataset.look || "");
      } catch {}
      sync();
    }),
  );
  dark.addEventListener("change", sync);
  sync();
</script>
