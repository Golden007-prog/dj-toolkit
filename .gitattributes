# Store text with LF line endings; Windows scripts keep CRLF so cmd.exe runs them.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.webp binary
*.ico binary
*.wav binary
*.mp3 binary
*.flac binary
*.woff2 binary

# Keep the lockfile out of diffs and language stats
website/package-lock.json linguist-generated=true -diff
